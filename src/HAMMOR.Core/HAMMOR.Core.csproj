<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HAMMOR Core: platform-neutral. MUST NOT reference WPF, Windows-only APIs,
    or any concrete provider. A future mobile client talks to this same Core
    through a gateway, so keep the TFM at plain net8.0.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>HAMMOR.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
