<!--
    The sidebar's rows: the shell's navigation items in the Living Core's
    visual language.

    WPF-UI's NavigationView keeps owning navigation, the pane, its toggle and
    its open/compact animation. Only the item template is replaced, because
    its row height (a hard-coded MinHeight of 40) cannot be changed any other
    way. The template is WPF-UI 4.3.0's compact item template with these
    differences:

      - A calmer, denser row: 36 px high with an 8 px radius and 2 px between
        rows, instead of 40 px and 4 px.
      - Hover and selection change only the fill; text and icon keep one
        foreground (a slim lens-teal indicator marks the selected row).
      - The icon stays on one axis, 20 px from the pane edge, whether the pane
        is open or a rail.
      - Nothing for nested items: HAMMOR has none. Add them back from the
        WPF-UI template if that changes.

    Colours come from the theme and ShellSurfaces through DynamicResource, so
    light and high-contrast themes keep working. Merged dictionaries cannot
    StaticResource each other, hence no references to Tokens.xaml here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <system:Double x:Key="SidebarRowHeight">36</system:Double>
    <CornerRadius x:Key="SidebarRowCornerRadius">8</CornerRadius>
    <Thickness x:Key="SidebarRowMargin">0,1</Thickness>

    <!-- Item template -->
    <ControlTemplate x:Key="HammorNavItemTemplate" TargetType="{x:Type ui:NavigationViewItem}">
        <Border x:Name="MainBorder"
                Height="{StaticResource SidebarRowHeight}"
                MinWidth="40"
                Background="{DynamicResource NavigationViewItemBackground}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                SnapsToDevicePixels="True">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Selection indicator, on the start edge (it mirrors in RTL). -->
                <Rectangle x:Name="ActiveRectangle"
                           Grid.Column="0"
                           Width="3"
                           Height="14"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                           Opacity="0"
                           RadiusX="1.5"
                           RadiusY="1.5" />

                <ContentPresenter x:Name="IconContentPresenter"
                                  Grid.Column="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Icon}"
                                  Focusable="False"
                                  TextElement.FontSize="16"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <!-- Zero wide in the rail, so the label is clipped away there. -->
                <ContentPresenter x:Name="ElementContentPresenter"
                                  Grid.Column="1"
                                  Margin="-4,0,8,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True"
                                  TextElement.FontSize="14"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <!-- Inline at the end of an open row; a corner dot on the icon
                     in the rail. -->
                <ContentPresenter x:Name="PART_InfoBadge"
                                  Grid.Column="2"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding InfoBadge}" />

                <!-- Required part name; unused because rows have no children. -->
                <Grid x:Name="PART_ChevronGrid"
                      Width="0"
                      Visibility="Collapsed" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsPaneOpen" Value="True">
                <Setter TargetName="PART_InfoBadge" Property="Grid.Column" Value="2" />
            </Trigger>
            <Trigger Property="IsPaneOpen" Value="False">
                <Setter TargetName="PART_InfoBadge" Property="Grid.Column" Value="0" />
                <Setter TargetName="PART_InfoBadge" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="PART_InfoBadge" Property="VerticalAlignment" Value="Top" />
                <Setter TargetName="PART_InfoBadge" Property="Margin" Value="0,3,3,0" />
            </Trigger>
            <Trigger Property="InfoBadge" Value="{x:Null}">
                <Setter TargetName="PART_InfoBadge" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconContentPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!-- Later triggers win: selected stays selected under the pointer. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
            </Trigger>
            <Trigger Property="IsActive" Value="True">
                <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1" />
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelected}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Item style: WPF-UI's default item setters, plus the row rhythm and a
         tooltip that appears only while the pane is a rail (an open row
         already shows its label). -->
    <Style x:Key="HammorNavItemStyle" TargetType="{x:Type ui:NavigationViewItem}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Margin" Value="{StaticResource SidebarRowMargin}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Border.CornerRadius" Value="{StaticResource SidebarRowCornerRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NavigationViewItemBorderBrush}" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTipService.IsEnabled" Value="False" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Style.Triggers>
            <Trigger Property="IsPaneOpen" Value="False">
                <Setter Property="ToolTipService.IsEnabled" Value="True" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A blocked-task dot: the Blocked colour, ringed in the pane colour so it
         reads against the icon. -->
    <Style x:Key="HammorAttentionBadgeStyle" TargetType="{x:Type ui:InfoBadge}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:InfoBadge}">
                    <Border Width="10"
                            Height="10"
                            Background="{DynamicResource StatusBlockedBrush}"
                            BorderBrush="{DynamicResource HammorShellBackgroundBrush}"
                            BorderThickness="2"
                            CornerRadius="5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
