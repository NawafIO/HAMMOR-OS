<!--
    HAMMOR design tokens.

    Every spacing value, corner radius, font size and semantic colour used by
    the app is defined here once. Views reference these keys via StaticResource
    and must not contain literal colours, margins or font sizes — that is what
    keeps the look consistent and themeable.

    Neutral colours are inherited from WPF-UI's theme dictionaries (they flip
    automatically between light and dark). Only the status accents are defined
    locally, because they carry meaning the base theme does not express.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Spacing scale (4pt base) ===== -->
    <Thickness x:Key="SpacingNone">0</Thickness>
    <Thickness x:Key="SpacingXs">4</Thickness>
    <Thickness x:Key="SpacingSm">8</Thickness>
    <Thickness x:Key="SpacingMd">12</Thickness>
    <Thickness x:Key="SpacingLg">16</Thickness>
    <Thickness x:Key="SpacingXl">24</Thickness>

    <Thickness x:Key="PagePadding">24,20,24,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="StackGap">0,0,0,12</Thickness>
    <Thickness x:Key="StackGapLarge">0,0,0,20</Thickness>
    <Thickness x:Key="FieldGap">0,0,0,8</Thickness>

    <system:Double x:Key="GapSm">8</system:Double>
    <system:Double x:Key="GapMd">12</system:Double>
    <system:Double x:Key="GapLg">16</system:Double>

    <!-- ===== Corner radii ===== -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">16</CornerRadius>

    <!-- ===== Typography scale ===== -->
    <system:Double x:Key="FontSizeCaption">11</system:Double>
    <system:Double x:Key="FontSizeBody">14</system:Double>
    <system:Double x:Key="FontSizeSubtitle">16</system:Double>
    <system:Double x:Key="FontSizeTitle">20</system:Double>
    <system:Double x:Key="FontSizeDisplay">28</system:Double>

    <!-- ===== Status accents =====
         Chosen for adequate contrast on both the light and dark Fluent
         backgrounds, so a status pill stays readable in either theme. -->
    <Color x:Key="StatusSuccessColor">#2EA043</Color>
    <Color x:Key="StatusWarningColor">#D29922</Color>
    <Color x:Key="StatusErrorColor">#D13438</Color>
    <Color x:Key="StatusNeutralColor">#8B949E</Color>
    <!-- Blocked tasks wait for the user (ADR-004 §5): a colour of their own,
         distinct from running (amber) and failed (red). -->
    <Color x:Key="StatusBlockedColor">#8957E5</Color>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="{StaticResource StatusNeutralColor}" />
    <SolidColorBrush x:Key="StatusBlockedBrush" Color="{StaticResource StatusBlockedColor}" />

    <!-- ===== Shared text styles ===== -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="{StaticResource StackGap}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="{StaticResource FieldGap}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- ===== Card surface =====
         Rounded, subtly elevated container used for every grouped block. -->
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="{StaticResource StackGap}" />
    </Style>

    <!-- ===== Living palette =====
         Measured from page 1 of the approved HAMMOR Living Core canvas. The
         Living Home is always drawn on the abyss, whatever the app theme: the
         Living Core and the mark are designed as light on the abyss ("white on
         abyss in every theme"), so these colours are fixed on purpose. -->
    <Color x:Key="AbyssColor">#03070A</Color>
    <Color x:Key="PearlColor">#EFF3F8</Color>
    <Color x:Key="MistColor">#AAB7C0</Color>
    <Color x:Key="FogColor">#828B94</Color>
    <Color x:Key="LensTealColor">#3ED0C8</Color>

    <SolidColorBrush x:Key="AbyssBrush" Color="{StaticResource AbyssColor}" />
    <SolidColorBrush x:Key="PearlBrush" Color="{StaticResource PearlColor}" />
    <SolidColorBrush x:Key="MistBrush" Color="{StaticResource MistColor}" />
    <SolidColorBrush x:Key="FogBrush" Color="{StaticResource FogColor}" />
    <SolidColorBrush x:Key="LensTealBrush" Color="{StaticResource LensTealColor}" />

    <!-- Shell surfaces. ShellSurfaces replaces these per theme at startup;
         these values only serve the designer and the first frame. -->
    <SolidColorBrush x:Key="HammorShellBackgroundBrush" Color="#060B0F" />
    <SolidColorBrush x:Key="HammorChromeStrokeBrush" Color="#10D6E8FF" />

    <!-- Dark glass and its hairline: the canvas's chips, rgba(214,232,255,.12). -->
    <SolidColorBrush x:Key="GlassFillBrush" Color="#C40A1117" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#1FD6E8FF" />
    <SolidColorBrush x:Key="GlassStrokeFocusBrush" Color="#8C3ED0C8" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#14D6E8FF" />

    <!-- The abyss, a hair lighter at the top, as if light comes from far above. -->
    <LinearGradientBrush x:Key="AbyssDepthBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#050B0F" />
        <GradientStop Offset="0.55" Color="#03070A" />
        <GradientStop Offset="1" Color="#020407" />
    </LinearGradientBrush>

    <!-- Light the Living Core casts on the page beyond its own aura: deep teal,
         very low, falling to nothing. Static; the aura itself breathes. -->
    <RadialGradientBrush x:Key="CoreAmbientBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#2E147078" />
        <GradientStop Offset="0.38" Color="#17147078" />
        <GradientStop Offset="0.7" Color="#08147078" />
        <GradientStop Offset="1" Color="#00147078" />
    </RadialGradientBrush>

    <!-- Focus light under the composer: teal, soft, never a glow ring. -->
    <RadialGradientBrush x:Key="ComposerFocusBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#243ED0C8" />
        <GradientStop Offset="0.6" Color="#0F3ED0C8" />
        <GradientStop Offset="1" Color="#003ED0C8" />
    </RadialGradientBrush>

    <!-- Display face: Alexandria Light (SIL Open Font License 1.1), as on the
         canvas. Missing glyphs fall back to the system font. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Alexandria Light</FontFamily>
    <system:Double x:Key="FontSizeHero">36</system:Double>

    <Style x:Key="HomeGreetingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
        <Setter Property="Foreground" Value="{StaticResource PearlBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="HomeBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource MistBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="540" />
    </Style>

    <Style x:Key="HomeTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource PearlBrush}" />
    </Style>

    <Style x:Key="HomeCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource FogBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Composer: dark glass, quieter than the Living Core ===== -->
    <Style x:Key="ComposerShell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="20,7,7,7" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeFocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Focus is shown by the composer's own border, not a dashed rectangle. -->
    <Style x:Key="ComposerTextBox" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PearlBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource LensTealBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource LensTealBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComposerSendButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource LensTealBrush}" />
        <Setter Property="Background" Value="#1F3ED0C8" />
        <Setter Property="BorderBrush" Value="#4D3ED0C8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#333ED0C8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#4D3ED0C8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LensTealBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet round icon button for the conversation header. -->
    <Style x:Key="GhostIconButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource MistBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="17">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GlassHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PearlBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GlassStrokeFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small action on a message or chip (copy, leave project). -->
    <Style x:Key="MessageActionButton" TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GlassHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PearlBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GlassStrokeFocusBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The project a conversation is scoped to: a lens-teal tinted pill. -->
    <Style x:Key="ChatProjectChip" TargetType="Border">
        <Setter Property="Padding" Value="10,4,6,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="#1A3ED0C8" />
        <Setter Property="BorderBrush" Value="#403ED0C8" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Chat bubbles: glass on the abyss, the user's tinted with the lens
         teal. Direction-neutral margins: the shell's FlowDirection mirrors
         them automatically for Arabic. -->
    <Style x:Key="UserMessageBubble" TargetType="Border">
        <Setter Property="Background" Value="#1A3ED0C8" />
        <Setter Property="BorderBrush" Value="#403ED0C8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MaxWidth" Value="620" />
        <Setter Property="Margin" Value="48,5,0,5" />
    </Style>

    <Style x:Key="AssistantMessageBubble" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MaxWidth" Value="620" />
        <Setter Property="Margin" Value="0,5,48,5" />
    </Style>

    <Style x:Key="ErrorMessageBubble" TargetType="Border" BasedOn="{StaticResource AssistantMessageBubble}">
        <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
    </Style>

    <!-- Small pill used for status and state labels. -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
