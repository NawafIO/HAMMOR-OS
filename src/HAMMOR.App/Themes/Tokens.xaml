<!--
    HAMMOR design tokens.

    Every spacing value, corner radius, font size and semantic colour used by
    the app is defined here once. Views reference these keys via StaticResource
    and must not contain literal colours, margins or font sizes — that is what
    keeps the look consistent and themeable.

    Neutral colours are inherited from WPF-UI's theme dictionaries (they flip
    automatically between light and dark). Only the status accents are defined
    locally, because they carry meaning the base theme does not express.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Spacing scale (4pt base) ===== -->
    <Thickness x:Key="SpacingNone">0</Thickness>
    <Thickness x:Key="SpacingXs">4</Thickness>
    <Thickness x:Key="SpacingSm">8</Thickness>
    <Thickness x:Key="SpacingMd">12</Thickness>
    <Thickness x:Key="SpacingLg">16</Thickness>
    <Thickness x:Key="SpacingXl">24</Thickness>

    <Thickness x:Key="PagePadding">24,20,24,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="StackGap">0,0,0,12</Thickness>
    <Thickness x:Key="StackGapLarge">0,0,0,20</Thickness>
    <Thickness x:Key="FieldGap">0,0,0,8</Thickness>

    <system:Double x:Key="GapSm">8</system:Double>
    <system:Double x:Key="GapMd">12</system:Double>
    <system:Double x:Key="GapLg">16</system:Double>

    <!-- ===== Corner radii ===== -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">16</CornerRadius>

    <!-- ===== Typography scale ===== -->
    <system:Double x:Key="FontSizeCaption">11</system:Double>
    <system:Double x:Key="FontSizeBody">14</system:Double>
    <system:Double x:Key="FontSizeSubtitle">16</system:Double>
    <system:Double x:Key="FontSizeTitle">20</system:Double>
    <system:Double x:Key="FontSizeDisplay">28</system:Double>

    <!-- ===== Status accents =====
         Chosen for adequate contrast on both the light and dark Fluent
         backgrounds, so a status pill stays readable in either theme. -->
    <Color x:Key="StatusSuccessColor">#2EA043</Color>
    <Color x:Key="StatusWarningColor">#D29922</Color>
    <Color x:Key="StatusErrorColor">#D13438</Color>
    <Color x:Key="StatusNeutralColor">#8B949E</Color>
    <!-- Blocked tasks wait for the user (ADR-004 §5): a colour of their own,
         distinct from running (amber) and failed (red). -->
    <Color x:Key="StatusBlockedColor">#8957E5</Color>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="{StaticResource StatusNeutralColor}" />
    <SolidColorBrush x:Key="StatusBlockedBrush" Color="{StaticResource StatusBlockedColor}" />

    <!-- ===== Shared text styles ===== -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="{StaticResource StackGap}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="{StaticResource FieldGap}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- ===== Card surface =====
         Rounded, subtly elevated container used for every grouped block. -->
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="{StaticResource StackGap}" />
    </Style>

    <!-- Chat bubbles. Direction-neutral margins: the shell's FlowDirection
         mirrors them automatically for Arabic. -->
    <Style x:Key="UserMessageBubble" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MaxWidth" Value="620" />
        <Setter Property="Margin" Value="48,4,0,4" />
    </Style>

    <Style x:Key="AssistantMessageBubble" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MaxWidth" Value="620" />
        <Setter Property="Margin" Value="0,4,48,4" />
    </Style>

    <Style x:Key="ErrorMessageBubble" TargetType="Border" BasedOn="{StaticResource AssistantMessageBubble}">
        <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
    </Style>

    <!-- Small pill used for status and state labels. -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
