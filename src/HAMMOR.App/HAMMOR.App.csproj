<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HAMMOR Windows UI. Presentation only: no AI, tool, memory or task logic
    lives here. Satellite resource assemblies are produced for Arabic so the
    localisation system can switch cultures at runtime.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HAMMOR.App</RootNamespace>
    <AssemblyName>HAMMOR</AssemblyName>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en;ar</SatelliteResourceLanguages>
    <!-- V2 Lens app icon (exe, taskbar, Alt+Tab). Regenerate with
         scripts/render-brand-assets.js. -->
    <ApplicationIcon>Assets\HAMMOR.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Startup splash: the static mark, shown while the host starts. -->
    <Resource Include="Assets\Splash.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests check the Living Core's fixed design data (budgets). -->
    <InternalsVisibleTo Include="HAMMOR.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HAMMOR.Core\HAMMOR.Core.csproj" />
    <ProjectReference Include="..\HAMMOR.Infrastructure\HAMMOR.Infrastructure.csproj" />
    <ProjectReference Include="..\HAMMOR.Platform.Windows\HAMMOR.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
