<!--
    Projects: a list (All conversations, then projects) and the selected
    item's details. Everything comes from data HAMMOR already keeps: projects,
    the conversation memory the agent pipeline writes for every turn, other
    project memory, and tasks. Nothing here is invented or editable yet.
-->
<Page x:Class="HAMMOR.App.Views.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:HAMMOR.App.Localization"
      xmlns:vm="clr-namespace:HAMMOR.App.ViewModels"
      Title="{loc:Loc Projects.Title}">

    <Page.Resources>
        <!-- A project row: icon, name, a short second line. -->
        <Style x:Key="ProjectListItem" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForeground}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" MinHeight="52" CornerRadius="8" Background="Transparent" Padding="0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Indicator"
                                           Width="3"
                                           Height="14"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Fill="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                           Opacity="0"
                                           RadiusX="1.5"
                                           RadiusY="1.5" />
                                <ui:SymbolIcon HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,2,0,0"
                                               FontSize="16"
                                               Foreground="{TemplateBinding Foreground}"
                                               Symbol="{Binding Icon}" />
                                <StackPanel Grid.Column="1" Margin="-4,0,10,0">
                                    <TextBlock FontSize="14"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Detail}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelected}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Project list ===================== -->
        <Border Grid.Column="0" Width="272" Style="{StaticResource SettingsNavPane}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource SettingsNavTitle}"
                           Text="{loc:Loc Projects.Title}" />

                <!-- Honest about what exists: projects are listed, not yet created here. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,12,12,0">
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="0,0,0,8"
                               Text="{loc:Loc Projects.Empty}"
                               Visibility="{Binding HasProjects, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="0,0,0,10"
                               Text="{loc:Loc Projects.CreateNotBuilt}" />
                    <CheckBox Content="{loc:Loc Projects.ShowArchived}"
                              IsChecked="{Binding ShowArchived, Mode=TwoWay}" />
                </StackPanel>

                <ListBox Style="{StaticResource SettingsNavList}"
                         ItemContainerStyle="{StaticResource ProjectListItem}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         AutomationProperties.Name="{loc:Loc Projects.Title}" />
            </DockPanel>
        </Border>

        <!-- ===================== Selected item ===================== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,24" MaxWidth="820" HorizontalAlignment="Left">

                <ui:InfoBar Margin="0,0,0,16"
                            Severity="Warning"
                            IsOpen="{Binding LoadFailed}"
                            IsClosable="False"
                            Title="{loc:Loc Projects.LoadFailed}" />

                <!-- All conversations -->
                <StackPanel Visibility="{Binding IsAllConversationsSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="{loc:Loc Projects.All}" />
                    <TextBlock Style="{StaticResource SettingsPageDescription}" Text="{loc:Loc Projects.All.Description}" />
                </StackPanel>

                <!-- A project -->
                <StackPanel Visibility="{Binding IsProjectSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="{Binding SelectedProject.Name}" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding KindLabel}" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding DatesLabel}" />
                    <TextBlock Style="{StaticResource SettingsPageDescription}"
                               Margin="0,10,0,16"
                               Text="{Binding SelectedProject.Description}" />

                    <WrapPanel Margin="0,0,0,20">
                        <ui:Button Margin="0,0,8,8"
                                   Padding="14,7"
                                   Appearance="Primary"
                                   Content="{loc:Loc Projects.ChatHere}"
                                   Icon="{ui:SymbolIcon Chat24}"
                                   Click="OnChatHereClick" />
                        <ui:Button Margin="0,0,8,8"
                                   Padding="14,7"
                                   Appearance="Secondary"
                                   Content="{loc:Loc Projects.CopyPath}"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Click="OnCopyPathClick"
                                   Visibility="{Binding HasRootPath, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>

                    <!-- The folder, left to right in both languages. -->
                    <TextBlock Margin="0,0,0,20"
                               Style="{StaticResource CaptionText}"
                               FlowDirection="LeftToRight"
                               HorizontalAlignment="Left"
                               Text="{Binding SelectedProject.RootPath}"
                               Visibility="{Binding HasRootPath, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Visibility="{Binding HasContext, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Projects.Context}" />
                        <Border Style="{StaticResource SettingsCard}" Padding="16,12">
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       MaxHeight="160"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedProject.Context}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <ui:ProgressRing Width="18"
                                 Height="18"
                                 Margin="0,0,0,12"
                                 HorizontalAlignment="Left"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}" />

                <!-- Saved conversations: one question and answer per entry. -->
                <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Projects.Conversations}" />
                <TextBlock Margin="4,0,4,24"
                           Style="{StaticResource SecondaryText}"
                           Text="{loc:Loc Projects.NoConversations}"
                           Visibility="{Binding HasExchanges, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Exchanges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExchangeItem}">
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold"
                                               Text="{Binding Question}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource SecondaryText}"
                                               MaxHeight="64"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Answer}" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding WhenLabel}" />
                                        <Border Margin="8,0,0,0"
                                                Padding="8,1"
                                                CornerRadius="8"
                                                Background="{DynamicResource NavigationViewItemBackgroundSelected}"
                                                Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ProjectName}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- A project's other memory. -->
                <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Projects.Notes}" />
                    <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NoteItem}">
                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10" Padding="16,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource CaptionText}" Text="{Binding KindLabel}" />
                                        </Grid>
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource SecondaryText}"
                                                   MaxHeight="64"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Snippet}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- A project's tasks. -->
                <StackPanel Visibility="{Binding IsProjectSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Projects.Tasks}" />
                    <TextBlock Margin="4,0,4,24"
                               Style="{StaticResource SecondaryText}"
                               Text="{loc:Loc Projects.NoTasks}"
                               Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Border Style="{StaticResource SettingsCard}"
                            Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl Margin="0,-1,0,0" ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProjectTaskItem}">
                                    <Border Padding="16,10"
                                            BorderBrush="{DynamicResource HammorChromeStrokeBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource TaskStateToBrush}}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,12,0"
                                                       Style="{StaticResource BodyText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Text="{Binding Title}" />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionText}"
                                                       Text="{Binding StateLabel}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ui:Button Margin="0,0,0,8"
                               Padding="12,6"
                               Appearance="Secondary"
                               Content="{loc:Loc Settings.Tasks.Open}"
                               Icon="{ui:SymbolIcon TaskListSquareLtr24}"
                               Click="OnOpenTasksClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
