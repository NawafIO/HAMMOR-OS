<Page x:Class="HAMMOR.App.Views.MemoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:HAMMOR.App.Localization"
      xmlns:memory="clr-namespace:HAMMOR.Core.Memory;assembly=HAMMOR.Core"
      Title="{loc:Loc Memory.Title}">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource PageTitleText}"
                       Text="{loc:Loc Memory.Title}" />

            <ui:Button Grid.Column="1"
                       Appearance="Secondary"
                       Padding="10,4"
                       Command="{Binding OpenMemoryFolderCommand}"
                       Content="{loc:Loc Memory.OpenFolder}"
                       Icon="{ui:SymbolIcon FolderOpen24}" />
        </Grid>

        <!-- Search is keyword-based; the semantic index is not implemented. -->
        <TextBlock Grid.Row="1"
                   Style="{StaticResource CaptionText}"
                   Margin="{StaticResource FieldGap}"
                   Text="{loc:Loc Memory.SemanticUnavailable}"
                   Visibility="{Binding IsSemanticSearchAvailable, Converter={StaticResource InverseBoolToVisibility}}" />

        <Grid Grid.Row="2" Margin="{StaticResource StackGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Loc Memory.SearchPlaceholder}" />

            <ui:Button Grid.Column="1"
                       Margin="8,0,0,0"
                       Appearance="Primary"
                       Padding="12,6"
                       Command="{Binding SearchCommand}"
                       Content="{loc:Loc Memory.Search}" />
        </Grid>

        <Grid Grid.Row="3">
            <TextBlock Style="{StaticResource SecondaryText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock.Text>
                    <Binding Path="HasSearched">
                        <Binding.Converter>
                            <loc:EmptyMemoryTextConverter />
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Text>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type memory:MemoryEntry}">
                            <Border Style="{StaticResource SurfaceCard}" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource BodyText}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}" />

                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource CaptionText}"
                                                   Text="{Binding Kind}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource SecondaryText}"
                                               Margin="0,6,0,0"
                                               MaxHeight="72"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Content}" />

                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Margin="0,6,0,0"
                                               Text="{Binding MarkdownPath}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
