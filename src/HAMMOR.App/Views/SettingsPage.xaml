<Page x:Class="HAMMOR.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:HAMMOR.App.Localization"
      xmlns:core="clr-namespace:HAMMOR.Core.Localization;assembly=HAMMOR.Core"
      Title="{loc:Loc Settings.Title}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitleText}" Text="{loc:Loc Settings.Title}" />

            <!-- ===================== General ===================== -->
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{loc:Loc Settings.General}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Language}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Settings.LanguageDescription}" />

                    <ComboBox Margin="{StaticResource StackGap}"
                              Width="280"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                              SelectedValuePath="Code">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:LanguageOption}">
                                <TextBlock Text="{Binding NativeName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Style="{StaticResource BodyText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Settings.Theme}" />

                    <ComboBox Margin="{StaticResource StackGap}"
                              Width="280"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding Draft.General.Theme, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedText}, ConverterParameter=Settings.Theme}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ui:ToggleSwitch Margin="{StaticResource FieldGap}"
                                     Content="{loc:Loc Settings.LaunchOnStartup}"
                                     IsChecked="{Binding Draft.General.LaunchOnStartup, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Tray.NotImplemented}" />

                    <ui:ToggleSwitch Content="{loc:Loc Settings.StartMinimised}"
                                     IsChecked="{Binding Draft.General.StartMinimisedToTray, Mode=TwoWay}"
                                     IsEnabled="False" />
                </StackPanel>
            </Border>

            <!-- ===================== AI provider ===================== -->
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{loc:Loc Settings.Ai}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Ai.Provider}" />
                    <ui:TextBox Margin="{StaticResource StackGap}"
                                Width="280"
                                HorizontalAlignment="Left"
                                Text="{Binding Draft.Ai.PrimaryProvider, Mode=TwoWay}"
                                IsReadOnly="True" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Ai.Model}" />
                    <ui:TextBox Margin="{StaticResource StackGap}"
                                Width="380"
                                HorizontalAlignment="Left"
                                Text="{Binding Draft.Ai.Model, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Ai.Effort}" />
                    <ComboBox Margin="{StaticResource StackGap}"
                              Width="200"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableEfforts}"
                              SelectedItem="{Binding Draft.Ai.Effort, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Ai.MaxTokens}" />
                    <ui:NumberBox Margin="{StaticResource StackGap}"
                                  Width="200"
                                  HorizontalAlignment="Left"
                                  Minimum="256"
                                  Maximum="128000"
                                  Value="{Binding Draft.Ai.MaxTokens, Mode=TwoWay}" />

                    <!-- API key: written straight to DPAPI, never into the config file -->
                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Ai.ApiKey}" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Foreground="{StaticResource StatusSuccessBrush}"
                               Text="{loc:Loc Settings.ApiKeyStored}"
                               Visibility="{Binding AnthropicKeyStored, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Settings.ApiKeyNotStored}"
                               Visibility="{Binding AnthropicKeyStored, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Grid Margin="{StaticResource StackGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:PasswordBox Grid.Column="0"
                                        x:Name="AnthropicKeyBox"
                                        PlaceholderText="{loc:Loc Settings.ApiKeyPlaceholder}"
                                        PasswordChanged="OnAnthropicKeyChanged" />

                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6"
                                   Appearance="Primary"
                                   Command="{Binding SaveAnthropicKeyCommand}"
                                   Content="{loc:Loc Settings.SaveKey}" />

                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="12,6"
                                   Appearance="Secondary"
                                   Command="{Binding ClearAnthropicKeyCommand}"
                                   Content="{loc:Loc Settings.ClearKey}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== Voice ===================== -->
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{loc:Loc Settings.Voice}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.TtsProvider}" />
                    <ui:TextBox Margin="{StaticResource StackGap}"
                                Width="280"
                                HorizontalAlignment="Left"
                                Text="{Binding Draft.Voice.TtsProvider, Mode=TwoWay}"
                                IsReadOnly="True" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource StackGap}"
                               Text="{loc:Loc Settings.Voice.NoStreaming}" />

                    <!-- The configured ElevenLabs voice id. Editable here;
                         nothing in the TTS pipeline hard-codes it. -->
                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.VoiceId}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Settings.Voice.VoiceIdDescription}" />
                    <ui:TextBox Margin="{StaticResource StackGap}"
                                Width="380"
                                HorizontalAlignment="Left"
                                Text="{Binding Draft.Voice.ElevenLabs.VoiceId, Mode=TwoWay}" />

                    <!-- ElevenLabs API key -->
                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.ApiKey}" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Foreground="{StaticResource StatusSuccessBrush}"
                               Text="{loc:Loc Settings.ApiKeyStored}"
                               Visibility="{Binding ElevenLabsKeyStored, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Settings.ApiKeyNotStored}"
                               Visibility="{Binding ElevenLabsKeyStored, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Grid Margin="{StaticResource StackGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:PasswordBox Grid.Column="0"
                                        x:Name="ElevenLabsKeyBox"
                                        PlaceholderText="{loc:Loc Settings.ApiKeyPlaceholder}"
                                        PasswordChanged="OnElevenLabsKeyChanged" />

                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6"
                                   Appearance="Primary"
                                   Command="{Binding SaveElevenLabsKeyCommand}"
                                   Content="{loc:Loc Settings.SaveKey}" />

                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="12,6"
                                   Appearance="Secondary"
                                   Command="{Binding ClearElevenLabsKeyCommand}"
                                   Content="{loc:Loc Settings.ClearKey}" />
                    </Grid>

                    <ui:ToggleSwitch Margin="{StaticResource FieldGap}"
                                     Content="{loc:Loc Settings.Voice.SpeakAutomatically}"
                                     IsChecked="{Binding Draft.Voice.SpeakResponsesAutomatically, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.OutputDevice}" />
                    <ComboBox Margin="{StaticResource StackGap}"
                              Width="380"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              ItemsSource="{Binding OutputDevices}"
                              SelectedValue="{Binding Draft.Voice.OutputDeviceId, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.InputDevice}" />
                    <ComboBox Margin="{StaticResource StackGap}"
                              Width="380"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              ItemsSource="{Binding InputDevices}"
                              SelectedValue="{Binding Draft.Voice.InputDeviceId, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.Volume}" />
                    <Slider Margin="{StaticResource StackGap}"
                            Width="280"
                            HorizontalAlignment="Left"
                            Minimum="0" Maximum="1"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Draft.Voice.OutputVolume, Mode=TwoWay}" />

                    <ui:Button HorizontalAlignment="Left"
                               Padding="12,6"
                               Appearance="Secondary"
                               Command="{Binding TestSpeechCommand}"
                               Content="{loc:Loc Settings.Voice.TestSpeech}"
                               Icon="{ui:SymbolIcon Speaker224}" />
                </StackPanel>
            </Border>

            <!-- ===================== Memory ===================== -->
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{loc:Loc Settings.Memory}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Memory.Location}" />
                    <ui:TextBox Margin="{StaticResource StackGap}"
                                Text="{Binding Draft.Memory.RootPath, Mode=TwoWay}" />

                    <ui:ToggleSwitch Content="{loc:Loc Settings.Memory.IndexOnStartup}"
                                     IsChecked="{Binding Draft.Memory.IndexOnStartup, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- ===================== Security ===================== -->
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{loc:Loc Settings.Security}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Security.AutoApprove}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Settings.Security.AutoApproveDescription}" />

                    <ComboBox Margin="{StaticResource StackGap}"
                              Width="240"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AutoApproveOptions}"
                              SelectedItem="{Binding Draft.Security.AutoApproveUpTo, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedText}, ConverterParameter=Permission}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Locked on: the permission engine enforces this floor
                         regardless, so the control must not suggest otherwise. -->
                    <ui:ToggleSwitch Content="{loc:Loc Settings.Security.AlwaysConfirmDestructive}"
                                     IsChecked="{Binding Draft.Security.AlwaysConfirmDestructive, Mode=TwoWay}"
                                     IsEnabled="False" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Settings.Security.DestructiveLocked}" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource StackGap}"
                               Text="{loc:Loc Settings.SecretsNote}" />
                </StackPanel>
            </Border>

            <!-- ===================== Actions ===================== -->
            <StackPanel Orientation="Horizontal" Margin="{StaticResource StackGapLarge}">
                <ui:Button Appearance="Primary"
                           Padding="16,8"
                           Command="{Binding SaveCommand}"
                           Content="{loc:Loc Settings.Save}" />

                <ui:Button Margin="12,0,0,0"
                           Appearance="Secondary"
                           Padding="16,8"
                           Command="{Binding TestConnectionsCommand}"
                           Content="{loc:Loc Settings.TestConnection}" />
            </StackPanel>

            <TextBlock Style="{StaticResource SecondaryText}"
                       Margin="{StaticResource StackGap}"
                       Text="{Binding StatusMessage}" />

            <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Loc Settings.ConfigFile}" />
            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ConfigurationFilePath}" />
        </StackPanel>
    </ScrollViewer>
</Page>
