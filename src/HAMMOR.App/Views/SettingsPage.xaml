<!--
    Settings v2. A secondary navigation pane (Back to HAMMOR, then seven
    categories) and the selected category's page. Every category edits the
    same draft, so one Save at the bottom writes them all; language and keys
    apply at once, as before. While Settings is open the main sidebar rests
    as its icon rail (MainWindow), so this pane reads as the navigation.
-->
<Page x:Class="HAMMOR.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:HAMMOR.App.Localization"
      xmlns:controls="clr-namespace:HAMMOR.App.Controls"
      xmlns:core="clr-namespace:HAMMOR.Core.Localization;assembly=HAMMOR.Core"
      Title="{loc:Loc Settings.Title}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Secondary navigation ===================== -->
        <Border Grid.Column="0" Style="{StaticResource SettingsNavPane}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Top"
                        Style="{StaticResource SettingsBackButton}"
                        Content="{loc:Loc Settings.Back}"
                        ToolTip="{loc:Loc Settings.Back.Name}"
                        AutomationProperties.Name="{loc:Loc Settings.Back.Name}"
                        Click="OnBackClick" />

                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource SettingsNavTitle}"
                           Text="{loc:Loc Settings.Title}" />

                <ListBox x:Name="SectionList"
                         Style="{StaticResource SettingsNavList}"
                         ItemContainerStyle="{StaticResource SettingsNavItem}"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSectionItem, Mode=TwoWay}"
                         SelectionChanged="OnSectionChanged"
                         AutomationProperties.Name="{loc:Loc Settings.Navigation}" />
            </DockPanel>
        </Border>

        <!-- ===================== Selected category ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="ContentScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,28,32,24" MaxWidth="760" HorizontalAlignment="Left">

                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="{Binding SelectedSectionItem.Label}" />
                    <TextBlock Style="{StaticResource SettingsPageDescription}" Text="{Binding SelectedSectionItem.Description}" />

                    <!-- ===================== Appearance ===================== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Appearance}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.Theme}"
                                                      Description="{loc:Loc Settings.Appearance.ThemeDescription}">
                                    <ComboBox Width="220"
                                              ItemsSource="{Binding AvailableThemes}"
                                              SelectedItem="{Binding Draft.General.Theme, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedText}, ConverterParameter=Settings.Theme}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </controls:SettingsRow>

                                <!-- Read only: the Living Core follows Windows'
                                     Animation effects; this says which way. -->
                                <controls:SettingsRow Header="{loc:Loc Settings.Appearance.Motion}"
                                                      Description="{loc:Loc Settings.Appearance.MotionDescription}">
                                    <TextBlock x:Name="MotionStatusText"
                                               MaxWidth="240"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyText}"
                                               TextWrapping="Wrap" />
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== AI & models ===================== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=AiModels}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.Ai.Provider}" IsStacked="True">
                                    <ComboBox MinWidth="380"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding ProviderOptions}"
                                              SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Label" />
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>

                        <!-- ===== Claude Code: the user's own Claude account ===== -->
                        <StackPanel Visibility="{Binding IsClaudeCodeSelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Settings.Ai.Group.ClaudeCode}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Margin="16,14,16,4">
                                    <TextBlock Style="{StaticResource SecondaryText}"
                                               Margin="{StaticResource StackGap}"
                                               Text="{loc:Loc Settings.ClaudeCode.Description}" />

                                    <!-- State, as Claude Code reports it -->
                                    <StackPanel Margin="{StaticResource FieldGap}" Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource StatusNeutralBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ClaudeCodeLevel}" Value="Good">
                                                            <Setter Property="Fill" Value="{StaticResource StatusSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ClaudeCodeLevel}" Value="Attention">
                                                            <Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ClaudeCodeLevel}" Value="Problem">
                                                            <Setter Property="Fill" Value="{StaticResource StatusErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BodyText}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ClaudeCodeStateText}" />
                                    </StackPanel>

                                    <!-- Version, method and Claude Code's own messages: left to right -->
                                    <TextBlock Margin="{StaticResource FieldGap}"
                                               Style="{StaticResource CaptionText}"
                                               FlowDirection="LeftToRight"
                                               HorizontalAlignment="Left"
                                               Text="{Binding ClaudeCodeDetailText}" />

                                    <TextBlock Margin="{StaticResource FieldGap}"
                                               Style="{StaticResource SecondaryText}"
                                               Text="{loc:Loc Settings.ClaudeCode.InstallHint}"
                                               Visibility="{Binding ShowClaudeCodeInstallHint, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="{StaticResource FieldGap}"
                                               Style="{StaticResource SecondaryText}"
                                               Text="{loc:Loc Settings.ClaudeCode.LauncherHint}"
                                               Visibility="{Binding ShowClaudeCodeLauncherHint, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="{StaticResource FieldGap}"
                                               Style="{StaticResource SecondaryText}"
                                               Text="{loc:Loc Settings.ClaudeCode.UpdateHint}"
                                               Visibility="{Binding ShowClaudeCodeUpdateHint, Converter={StaticResource BoolToVisibility}}" />

                                    <WrapPanel Margin="{StaticResource StackGap}" Orientation="Horizontal">
                                        <ui:Button Margin="0,0,8,8"
                                                   Padding="12,6"
                                                   Appearance="Primary"
                                                   Command="{Binding SignInToClaudeCodeCommand}"
                                                   Content="{loc:Loc Settings.ClaudeCode.SignIn}"
                                                   Visibility="{Binding CanSignInToClaudeCode, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Margin="0,0,8,8"
                                                   Padding="12,6"
                                                   Appearance="Secondary"
                                                   Command="{Binding ReconnectClaudeCodeCommand}"
                                                   Content="{loc:Loc Settings.ClaudeCode.Reconnect}"
                                                   Visibility="{Binding CanReconnectClaudeCode, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Margin="0,0,8,8"
                                                   Padding="12,6"
                                                   Appearance="Secondary"
                                                   Command="{Binding SignOutOfClaudeCodeCommand}"
                                                   Content="{loc:Loc Settings.ClaudeCode.SignOut}"
                                                   Visibility="{Binding CanSignOutOfClaudeCode, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Margin="0,0,8,8"
                                                   Padding="12,6"
                                                   Appearance="Secondary"
                                                   Command="{Binding RefreshClaudeCodeCommand}"
                                                   Content="{loc:Loc Settings.ClaudeCode.Refresh}"
                                                   Icon="{ui:SymbolIcon ArrowSync24}" />
                                    </WrapPanel>

                                    <TextBlock Margin="{StaticResource FieldGap}"
                                               Style="{StaticResource SecondaryText}"
                                               Text="{loc:Loc Settings.ClaudeCode.Waiting}"
                                               Visibility="{Binding IsWaitingForClaudeCodeSignIn, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Margin="{StaticResource FieldGap}"
                                               Style="{StaticResource CaptionText}"
                                               Text="{loc:Loc Settings.ClaudeCode.SignOutNote}"
                                               Visibility="{Binding CanSignOutOfClaudeCode, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Margin="{StaticResource StackGap}"
                                               Style="{StaticResource CaptionText}"
                                               Text="{loc:Loc Settings.ClaudeCode.TextOnly}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Anthropic API key: optional ===== -->
                        <StackPanel Visibility="{Binding IsApiKeySelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Settings.Ai.Group.ApiKey}" />
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Margin="4,0,4,12"
                                       Text="{loc:Loc Settings.Ai.ApiKeyOptional}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Style="{StaticResource SettingsCardRows}">
                                    <controls:SettingsRow Header="{loc:Loc Settings.Ai.Model}">
                                        <ui:TextBox Width="260"
                                                    FlowDirection="LeftToRight"
                                                    Text="{Binding Draft.Ai.Model, Mode=TwoWay}" />
                                    </controls:SettingsRow>

                                    <controls:SettingsRow Header="{loc:Loc Settings.Ai.Effort}">
                                        <ComboBox Width="160"
                                                  ItemsSource="{Binding AvailableEfforts}"
                                                  SelectedItem="{Binding Draft.Ai.Effort, Mode=TwoWay}" />
                                    </controls:SettingsRow>

                                    <controls:SettingsRow Header="{loc:Loc Settings.Ai.MaxTokens}">
                                        <ui:NumberBox Width="160"
                                                      Minimum="256"
                                                      Maximum="128000"
                                                      Value="{Binding Draft.Ai.MaxTokens, Mode=TwoWay}" />
                                    </controls:SettingsRow>

                                    <!-- API key: written straight to DPAPI, never into the config file -->
                                    <controls:SettingsRow Header="{loc:Loc Settings.Ai.ApiKey}" IsStacked="True">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionText}"
                                                       Margin="{StaticResource FieldGap}"
                                                       Foreground="{StaticResource StatusSuccessBrush}"
                                                       Text="{loc:Loc Settings.ApiKeyStored}"
                                                       Visibility="{Binding AnthropicKeyStored, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Style="{StaticResource CaptionText}"
                                                       Margin="{StaticResource FieldGap}"
                                                       Text="{loc:Loc Settings.ApiKeyNotStored}"
                                                       Visibility="{Binding AnthropicKeyStored, Converter={StaticResource InverseBoolToVisibility}}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ui:PasswordBox Grid.Column="0"
                                                                x:Name="AnthropicKeyBox"
                                                                PlaceholderText="{loc:Loc Settings.ApiKeyPlaceholder}"
                                                                PasswordChanged="OnAnthropicKeyChanged" />

                                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6"
                                                           Appearance="Primary"
                                                           Command="{Binding SaveAnthropicKeyCommand}"
                                                           Content="{loc:Loc Settings.SaveKey}" />

                                                <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="12,6"
                                                           Appearance="Secondary"
                                                           Command="{Binding ClearAnthropicKeyCommand}"
                                                           Content="{loc:Loc Settings.ClearKey}" />
                                            </Grid>
                                        </StackPanel>
                                    </controls:SettingsRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===================== Voice ===================== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Voice}">
                        <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Settings.Voice.Group.ElevenLabs}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.Voice.TtsProvider}"
                                                      Description="{loc:Loc Settings.Voice.NoStreaming}">
                                    <ui:TextBox Width="200"
                                                FlowDirection="LeftToRight"
                                                Text="{Binding Draft.Voice.TtsProvider, Mode=TwoWay}"
                                                IsReadOnly="True" />
                                </controls:SettingsRow>

                                <!-- The configured ElevenLabs voice id. Editable here;
                                     nothing in the TTS pipeline hard-codes it. -->
                                <controls:SettingsRow Header="{loc:Loc Settings.Voice.VoiceId}"
                                                      Description="{loc:Loc Settings.Voice.VoiceIdDescription}">
                                    <ui:TextBox Width="260"
                                                FlowDirection="LeftToRight"
                                                Text="{Binding Draft.Voice.ElevenLabs.VoiceId, Mode=TwoWay}" />
                                </controls:SettingsRow>

                                <!-- ElevenLabs API key -->
                                <controls:SettingsRow Header="{loc:Loc Settings.Voice.ApiKey}" IsStacked="True">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Margin="{StaticResource FieldGap}"
                                                   Foreground="{StaticResource StatusSuccessBrush}"
                                                   Text="{loc:Loc Settings.ApiKeyStored}"
                                                   Visibility="{Binding ElevenLabsKeyStored, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Margin="{StaticResource FieldGap}"
                                                   Text="{loc:Loc Settings.ApiKeyNotStored}"
                                                   Visibility="{Binding ElevenLabsKeyStored, Converter={StaticResource InverseBoolToVisibility}}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:PasswordBox Grid.Column="0"
                                                            x:Name="ElevenLabsKeyBox"
                                                            PlaceholderText="{loc:Loc Settings.ApiKeyPlaceholder}"
                                                            PasswordChanged="OnElevenLabsKeyChanged" />

                                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6"
                                                       Appearance="Primary"
                                                       Command="{Binding SaveElevenLabsKeyCommand}"
                                                       Content="{loc:Loc Settings.SaveKey}" />

                                            <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="12,6"
                                                       Appearance="Secondary"
                                                       Command="{Binding ClearElevenLabsKeyCommand}"
                                                       Content="{loc:Loc Settings.ClearKey}" />
                                        </Grid>
                                    </StackPanel>
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Settings.Voice.Group.Playback}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.Voice.SpeakAutomatically}">
                                    <ui:ToggleSwitch AutomationProperties.Name="{loc:Loc Settings.Voice.SpeakAutomatically}"
                                                     IsChecked="{Binding Draft.Voice.SpeakResponsesAutomatically, Mode=TwoWay}" />
                                </controls:SettingsRow>

                                <controls:SettingsRow Header="{loc:Loc Settings.Voice.OutputDevice}">
                                    <ComboBox Width="260"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              ItemsSource="{Binding OutputDevices}"
                                              SelectedValue="{Binding Draft.Voice.OutputDeviceId, Mode=TwoWay}" />
                                </controls:SettingsRow>

                                <controls:SettingsRow Header="{loc:Loc Settings.Voice.InputDevice}">
                                    <ComboBox Width="260"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              ItemsSource="{Binding InputDevices}"
                                              SelectedValue="{Binding Draft.Voice.InputDeviceId, Mode=TwoWay}" />
                                </controls:SettingsRow>

                                <controls:SettingsRow Header="{loc:Loc Settings.Voice.Volume}">
                                    <Slider Width="220"
                                            Minimum="0" Maximum="1"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="{loc:Loc Settings.Voice.Volume}"
                                            Value="{Binding Draft.Voice.OutputVolume, Mode=TwoWay}" />
                                </controls:SettingsRow>

                                <controls:SettingsRow Header="{loc:Loc Settings.Voice.Test.Header}"
                                                      Description="{loc:Loc Settings.Voice.Test.Description}">
                                    <ui:Button Padding="12,6"
                                               Appearance="Secondary"
                                               Command="{Binding TestSpeechCommand}"
                                               Content="{loc:Loc Settings.Voice.TestSpeech}"
                                               Icon="{ui:SymbolIcon Speaker224}" />
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Memory ===================== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Memory}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.Memory.Location}" IsStacked="True">
                                    <ui:TextBox FlowDirection="LeftToRight"
                                                Text="{Binding Draft.Memory.RootPath, Mode=TwoWay}" />
                                </controls:SettingsRow>

                                <controls:SettingsRow Header="{loc:Loc Settings.Memory.IndexOnStartup}">
                                    <ui:ToggleSwitch AutomationProperties.Name="{loc:Loc Settings.Memory.IndexOnStartup}"
                                                     IsChecked="{Binding Draft.Memory.IndexOnStartup, Mode=TwoWay}" />
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Security ===================== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Security}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.Security.AutoApprove}"
                                                      Description="{loc:Loc Settings.Security.AutoApproveDescription}">
                                    <ComboBox Width="200"
                                              ItemsSource="{Binding AutoApproveOptions}"
                                              SelectedItem="{Binding Draft.Security.AutoApproveUpTo, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedText}, ConverterParameter=Permission}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </controls:SettingsRow>

                                <!-- Locked on: the permission engine enforces this floor
                                     regardless, so the control must not suggest otherwise. -->
                                <controls:SettingsRow Header="{loc:Loc Settings.Security.AlwaysConfirmDestructive}"
                                                      Description="{loc:Loc Settings.Security.DestructiveLocked}">
                                    <ui:ToggleSwitch AutomationProperties.Name="{loc:Loc Settings.Security.AlwaysConfirmDestructive}"
                                                     IsChecked="{Binding Draft.Security.AlwaysConfirmDestructive, Mode=TwoWay}"
                                                     IsEnabled="False" />
                                </controls:SettingsRow>

                                <controls:SettingsRow Header="{loc:Loc Settings.Security.Secrets}"
                                                      Description="{loc:Loc Settings.SecretsNote}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Tasks & scheduler ===================== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Tasks}">
                        <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Settings.Tasks.Group.Rules}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.Tasks.Rule.ReadOnly}" />
                                <controls:SettingsRow Header="{loc:Loc Settings.Tasks.Rule.Grant}" />
                                <controls:SettingsRow Header="{loc:Loc Settings.Tasks.Rule.Blocked}" />
                                <controls:SettingsRow Header="{loc:Loc Settings.Tasks.Rule.OneAtATime}" />
                                <controls:SettingsRow Header="{loc:Loc Settings.Tasks.Rule.NoRecurrence}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Margin="4,-12,4,24"
                                   Text="{loc:Loc Settings.Tasks.Fixed}" />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.Tasks.Open.Header}"
                                                      Description="{loc:Loc Settings.Tasks.Open.Description}">
                                    <ui:Button Padding="12,6"
                                               Appearance="Secondary"
                                               Content="{loc:Loc Settings.Tasks.Open}"
                                               Icon="{ui:SymbolIcon TaskListSquareLtr24}"
                                               Click="OnOpenTasksClick" />
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== System ===================== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=System}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <!-- Applies and persists at once. -->
                                <controls:SettingsRow Header="{loc:Loc Settings.Language}"
                                                      Description="{loc:Loc Settings.LanguageDescription}">
                                    <ComboBox Width="220"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                              SelectedValuePath="Code">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type core:LanguageOption}">
                                                <TextBlock Text="{Binding NativeName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Settings.System.Group.Startup}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.LaunchOnStartup}"
                                                      Description="{loc:Loc Tray.NotImplemented}">
                                    <ui:ToggleSwitch AutomationProperties.Name="{loc:Loc Settings.LaunchOnStartup}"
                                                     IsChecked="{Binding Draft.General.LaunchOnStartup, Mode=TwoWay}" />
                                </controls:SettingsRow>

                                <controls:SettingsRow Header="{loc:Loc Settings.StartMinimised}">
                                    <ui:ToggleSwitch AutomationProperties.Name="{loc:Loc Settings.StartMinimised}"
                                                     IsChecked="{Binding Draft.General.StartMinimisedToTray, Mode=TwoWay}"
                                                     IsEnabled="False" />
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Settings.System.Group.Connections}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.System.Connections.Header}"
                                                      Description="{loc:Loc Settings.System.Connections.Description}">
                                    <ui:Button Padding="12,6"
                                               Appearance="Secondary"
                                               Command="{Binding TestConnectionsCommand}"
                                               Content="{loc:Loc Settings.TestConnection}" />
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{loc:Loc Settings.System.Group.Storage}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Style="{StaticResource SettingsCardRows}">
                                <controls:SettingsRow Header="{loc:Loc Settings.ConfigFile}" IsStacked="True">
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               FlowDirection="LeftToRight"
                                               HorizontalAlignment="Left"
                                               Text="{Binding ConfigurationFilePath}" />
                                </controls:SettingsRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== Save, for every category ===================== -->
            <Border Grid.Row="1" Style="{StaticResource SettingsActionBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0"
                               VerticalAlignment="Center"
                               Appearance="Primary"
                               Padding="16,8"
                               Command="{Binding SaveCommand}"
                               Content="{loc:Loc Settings.Save}" />

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusMessage}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Loc Settings.SaveHint}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
