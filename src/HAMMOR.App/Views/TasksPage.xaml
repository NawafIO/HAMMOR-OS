<Page x:Class="HAMMOR.App.Views.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:HAMMOR.App.Localization"
      xmlns:tasks="clr-namespace:HAMMOR.Core.Tasks;assembly=HAMMOR.Core"
      Title="{loc:Loc Tasks.Title}">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource PageTitleText}"
                   Text="{loc:Loc Tasks.Title}" />

        <!-- States what the task system does and does not do yet. -->
        <ui:InfoBar Grid.Row="1"
                    Severity="Informational"
                    IsOpen="True"
                    IsClosable="False"
                    Margin="{StaticResource StackGap}"
                    Title="{loc:Loc Common.NotImplemented}"
                    Message="{loc:Loc Tasks.SchedulerNote}" />

        <Grid Grid.Row="2">
            <TextBlock Style="{StaticResource SecondaryText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{loc:Loc Tasks.Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tasks:HammorTask}">
                            <Border Style="{StaticResource SurfaceCard}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource TaskStateToBrush}}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource BodyText}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource SecondaryText}"
                                                   Text="{Binding Description}" />
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource StatusErrorBrush}"
                                                   Text="{Binding Error}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding State, Converter={StaticResource EnumToLocalizedText}, ConverterParameter=Tasks.State}" />
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding CreatedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
