<Page x:Class="HAMMOR.App.Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:HAMMOR.App.Localization"
      xmlns:vm="clr-namespace:HAMMOR.App.ViewModels"
      d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{loc:Loc Chat.Title}">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource PageTitleText}"
                       Text="{loc:Loc Chat.Title}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Appearance="Secondary"
                           Padding="8,4"
                           Command="{Binding SpeakLastCommand}"
                           Icon="{ui:SymbolIcon Speaker224}"
                           ToolTip="{loc:Loc Chat.Speak}" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           Padding="8,4"
                           Command="{Binding StopSpeakingCommand}"
                           Icon="{ui:SymbolIcon SpeakerMute24}"
                           ToolTip="{loc:Loc Chat.StopSpeaking}" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           Padding="8,4"
                           Command="{Binding ClearCommand}"
                           Icon="{ui:SymbolIcon Broom24}"
                           ToolTip="{loc:Loc Chat.Clear}" />
            </StackPanel>
        </Grid>

        <!-- Transcript -->
        <ScrollViewer Grid.Row="1"
                      x:Name="TranscriptScroll"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,8">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionTitleText}"
                               HorizontalAlignment="Center"
                               Text="{loc:Loc Chat.EmptyTitle}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               MaxWidth="420"
                               TextAlignment="Center"
                               Text="{loc:Loc Chat.EmptyBody}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Messages}"
                              Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <Grid>
                                <!-- User bubble -->
                                <Border Style="{StaticResource UserMessageBubble}"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>

                                <!-- Assistant bubble -->
                                <Border Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource AssistantMessageBubble}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource StatusErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Margin="0,0,0,2"
                                                   Text="{Binding AuthorLabel}" />
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Progress: shows which pipeline stage is running -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,4"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource SecondaryText}"
                       Text="{Binding ProgressDetail}" />
        </StackPanel>

        <!-- Composer -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Row="0" Grid.Column="0"
                        x:Name="InputBox"
                        Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Loc Chat.InputPlaceholder}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MaxHeight="140"
                        VerticalContentAlignment="Top"
                        KeyDown="OnInputKeyDown" />

            <ui:Button Grid.Row="0" Grid.Column="1"
                       Margin="8,0,0,0"
                       Appearance="Primary"
                       VerticalAlignment="Bottom"
                       Padding="14,8"
                       Command="{Binding SendCommand}"
                       Content="{loc:Loc Chat.Send}"
                       Icon="{ui:SymbolIcon Send24}" />

            <!-- Honest statement about voice input rather than a dead button -->
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,6,0,0"
                       Style="{StaticResource CaptionText}"
                       Text="{loc:Loc Chat.VoiceInputUnavailable}"
                       Visibility="{Binding IsVoiceInputAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </Grid>
</Page>
