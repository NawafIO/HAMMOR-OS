<ui:FluentWindow x:Class="HAMMOR.App.Views.ConfirmationDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:HAMMOR.App.Localization"
                 Title="{loc:Loc Confirm.Title}"
                 Width="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Loc Confirm.Title}"
                     FlowDirection="LeftToRight"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,24">

            <TextBlock Style="{StaticResource SectionTitleText}" Text="{loc:Loc Confirm.Title}" />

            <!-- What is being asked for -->
            <Border Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource CaptionText}"
                               Margin="0,0,12,4"
                               Text="{loc:Loc Confirm.Tool}" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource BodyText}"
                               Margin="0,0,0,4"
                               FontWeight="SemiBold"
                               FlowDirection="LeftToRight"
                               HorizontalAlignment="Left"
                               Text="{Binding ToolName}" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource CaptionText}"
                               Margin="0,0,12,0"
                               Text="{loc:Loc Confirm.Permission}" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource StatusWarningBrush}"
                               Text="{Binding PermissionLabel}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SecondaryText}"
                       Margin="{StaticResource StackGap}"
                       Text="{Binding Summary}" />

            <!-- Arguments, so approval is informed rather than blind -->
            <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Loc Confirm.Details}" />
            <Border Style="{StaticResource SurfaceCard}" Padding="12">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <!-- Invariant key: value text (paths, tool names): always
                         left-to-right, also in Arabic. -->
                    <TextBlock Style="{StaticResource BodyText}"
                               FontFamily="Consolas"
                               FlowDirection="LeftToRight"
                               Text="{Binding Details}" />
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <!-- Deny is the default focus: approving must be deliberate. -->
                <ui:Button x:Name="DenyButton"
                           Appearance="Secondary"
                           Padding="16,8"
                           IsCancel="True"
                           Click="OnDeny"
                           Content="{loc:Loc Confirm.Deny}" />

                <ui:Button Margin="12,0,0,0"
                           Appearance="Primary"
                           Padding="16,8"
                           Click="OnAllow"
                           Content="{loc:Loc Confirm.Allow}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
