<ui:FluentWindow x:Class="HAMMOR.App.Views.FirstRunWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:HAMMOR.App.Localization"
                 xmlns:core="clr-namespace:HAMMOR.Core.Localization;assembly=HAMMOR.Core"
                 Title="{loc:Loc Setup.Title}"
                 Width="680"
                 Height="620"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationSource.Instance}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Loc Setup.Title}"
                     FlowDirection="LeftToRight"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Margin="28,8,28,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============ Step 1: language ============ -->
                <StackPanel Visibility="{Binding ViewModel.IsLanguageStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="{loc:Loc Setup.Title}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Margin="{StaticResource StackGap}"
                               Text="{loc:Loc Setup.ChooseLanguage}" />

                    <!-- Available immediately, so the rest of the wizard is in
                         the chosen language. -->
                    <ComboBox Width="300"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding ViewModel.AvailableLanguages}"
                              SelectedValue="{Binding ViewModel.SelectedLanguage, Mode=TwoWay}"
                              SelectedValuePath="Code">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:LanguageOption}">
                                <TextBlock Text="{Binding NativeName}" FontSize="{StaticResource FontSizeSubtitle}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource StackGapLarge}"
                               Text="{loc:Loc Setup.OptionalNote}" />
                </StackPanel>

                <!-- ============ Step 2: Claude ============ -->
                <StackPanel Visibility="{Binding ViewModel.IsAiStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="{loc:Loc Setup.AiStep}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Ai.Model}" />
                    <ui:TextBox Margin="{StaticResource StackGap}"
                                Text="{Binding ViewModel.Draft.Ai.Model, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Ai.ApiKey}" />
                    <ui:PasswordBox x:Name="AnthropicKeyBox"
                                    Margin="{StaticResource StackGap}"
                                    PlaceholderText="{loc:Loc Settings.ApiKeyPlaceholder}"
                                    PasswordChanged="OnAnthropicKeyChanged" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource StackGap}"
                               Text="{loc:Loc Settings.SecretsNote}" />

                    <!-- Informational: HAMMOR uses the Claude API directly and
                         does not require the CLI. -->
                    <TextBlock Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource StatusSuccessBrush}"
                               Text="{loc:Loc Setup.ClaudeCodeDetected}"
                               Visibility="{Binding ViewModel.ClaudeCodeDetected, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="{loc:Loc Setup.ClaudeCodeNotDetected}"
                               Visibility="{Binding ViewModel.ClaudeCodeDetected, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>

                <!-- ============ Step 3: voice ============ -->
                <StackPanel Visibility="{Binding ViewModel.IsVoiceStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="{loc:Loc Setup.VoiceStep}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.VoiceId}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Settings.Voice.VoiceIdDescription}" />
                    <ui:TextBox Margin="{StaticResource StackGap}"
                                Text="{Binding ViewModel.Draft.Voice.ElevenLabs.VoiceId, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.ApiKey}" />
                    <ui:PasswordBox x:Name="ElevenLabsKeyBox"
                                    Margin="{StaticResource StackGap}"
                                    PlaceholderText="{loc:Loc Settings.ApiKeyPlaceholder}"
                                    PasswordChanged="OnElevenLabsKeyChanged" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.OutputDevice}" />
                    <ComboBox Margin="{StaticResource StackGap}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              ItemsSource="{Binding ViewModel.OutputDevices}"
                              SelectedValue="{Binding ViewModel.Draft.Voice.OutputDeviceId, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Voice.InputDevice}" />
                    <ComboBox Margin="{StaticResource StackGap}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              ItemsSource="{Binding ViewModel.InputDevices}"
                              SelectedValue="{Binding ViewModel.Draft.Voice.InputDeviceId, Mode=TwoWay}" />

                    <!-- Voice input cannot work in Phase 1; say so here rather
                         than letting the user discover it later. -->
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource StackGap}"
                               Text="{loc:Loc Chat.VoiceInputUnavailable}" />
                </StackPanel>

                <!-- ============ Step 4: memory ============ -->
                <StackPanel Visibility="{Binding ViewModel.IsMemoryStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="{loc:Loc Setup.MemoryStep}" />

                    <TextBlock Style="{StaticResource BodyText}" Text="{loc:Loc Settings.Memory.Location}" />
                    <ui:TextBox Margin="{StaticResource StackGap}"
                                Text="{Binding ViewModel.Draft.Memory.RootPath, Mode=TwoWay}" />

                    <ui:ToggleSwitch Margin="{StaticResource StackGap}"
                                     Content="{loc:Loc Settings.Memory.IndexOnStartup}"
                                     IsChecked="{Binding ViewModel.Draft.Memory.IndexOnStartup, Mode=TwoWay}" />

                    <ui:ToggleSwitch Content="{loc:Loc Settings.LaunchOnStartup}"
                                     IsChecked="{Binding ViewModel.Draft.General.LaunchOnStartup, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="{StaticResource FieldGap}"
                               Text="{loc:Loc Tray.NotImplemented}" />
                </StackPanel>

                <!-- ============ Step 5: done ============ -->
                <StackPanel Visibility="{Binding ViewModel.IsFinalStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="{loc:Loc Setup.ReadyTitle}" />

                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <!-- "هامور جاهز." in Arabic, "HAMMOR is ready." in English -->
                            <TextBlock FontSize="{StaticResource FontSizeDisplay}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusSuccessBrush}"
                                       Text="{loc:Loc Setup.ReadyMessage}" />
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Margin="0,8,0,0"
                                       Text="{loc:Loc Setup.OptionalNote}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Navigation -->
        <Grid Grid.Row="2" Margin="28,16,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Appearance="Secondary"
                       Padding="16,8"
                       Command="{Binding ViewModel.BackCommand}"
                       Content="{loc:Loc Setup.Back}"
                       Visibility="{Binding ViewModel.CanGoBack, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Grid.Column="1"
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Binding ViewModel.StepLabel}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Appearance="Primary"
                           Padding="16,8"
                           Command="{Binding ViewModel.NextCommand}"
                           Content="{loc:Loc Setup.Next}"
                           Visibility="{Binding ViewModel.IsFinalStep, Converter={StaticResource InverseBoolToVisibility}}" />

                <ui:Button Appearance="Primary"
                           Padding="16,8"
                           Command="{Binding ViewModel.FinishCommand}"
                           Content="{loc:Loc Setup.Finish}"
                           Visibility="{Binding ViewModel.IsFinalStep, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
