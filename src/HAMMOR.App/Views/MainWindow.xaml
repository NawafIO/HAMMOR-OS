<ui:FluentWindow x:Class="HAMMOR.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:HAMMOR.App.Localization"
                 xmlns:views="clr-namespace:HAMMOR.App.Views"
                 Title="{loc:Loc App.Title}"
                 Width="1180"
                 Height="780"
                 MinWidth="840"
                 MinHeight="560"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 FlowDirection="{Binding FlowDirection}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar. FlowDirection is forced LTR so the window buttons stay
             on the right in Arabic, matching every other Windows 11 app. -->
        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Loc App.Title}"
                     FlowDirection="LeftToRight"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <!-- Sidebar navigation. Pages are resolved from DI by the
             INavigationViewPageProvider so each view gets its view model. -->
        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="220">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Loc Nav.Chat}"
                                       Icon="{ui:SymbolIcon ChatMultiple24}"
                                       TargetPageType="{x:Type views:ChatPage}" />
                <ui:NavigationViewItem Content="{loc:Loc Nav.Activity}"
                                       Icon="{ui:SymbolIcon DocumentBulletList24}"
                                       TargetPageType="{x:Type views:ActivityPage}" />
                <ui:NavigationViewItem Content="{loc:Loc Nav.Tasks}"
                                       Icon="{ui:SymbolIcon TaskListSquareLtr24}"
                                       TargetPageType="{x:Type views:TasksPage}" />
                <ui:NavigationViewItem Content="{loc:Loc Nav.Memory}"
                                       Icon="{ui:SymbolIcon Brain24}"
                                       TargetPageType="{x:Type views:MemoryPage}" />
                <ui:NavigationViewItem Content="{loc:Loc Nav.Projects}"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       TargetPageType="{x:Type views:ProjectsPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:Loc Nav.Settings}"
                                       Icon="{ui:SymbolIcon Options24}"
                                       TargetPageType="{x:Type views:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Status bar: honest readiness signals for every provider and device. -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- HAMMOR overall state -->
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Status.IsReady, Converter={StaticResource BooleanToBrush}}" />
                            <TextBlock Margin="6,0,0,0"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <Binding Path="Status.IsBusy">
                                        <Binding.Converter>
                                            <views:BusyStateTextConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Claude -->
                    <Border Style="{StaticResource StatusPill}"
                            ToolTip="{Binding Status.Claude.Detail}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Status.Claude, Converter={StaticResource ProviderStateToBrush}}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Status.Claude}" />
                        </StackPanel>
                    </Border>

                    <!-- ElevenLabs -->
                    <Border Style="{StaticResource StatusPill}"
                            ToolTip="{Binding Status.TextToSpeech.Detail}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Status.TextToSpeech, Converter={StaticResource ProviderStateToBrush}}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Status.ElevenLabs}" />
                        </StackPanel>
                    </Border>

                    <!-- Speech-to-text: not implemented, shown as such -->
                    <Border Style="{StaticResource StatusPill}"
                            ToolTip="{Binding Status.SpeechToText.Detail}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Status.SpeechToText, Converter={StaticResource ProviderStateToBrush}}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Status.SpeechToText}" />
                        </StackPanel>
                    </Border>

                    <!-- Microphone -->
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Status.MicrophoneAvailable, Converter={StaticResource BooleanToBrush}}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Status.Microphone}" />
                        </StackPanel>
                    </Border>

                    <!-- Speaker -->
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Status.SpeakerAvailable, Converter={StaticResource BooleanToBrush}}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Status.Speaker}" />
                        </StackPanel>
                    </Border>

                    <!-- Background tasks -->
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Status.BackgroundTasks}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="{Binding Status.RunningTaskCount}" />
                        </StackPanel>
                    </Border>
                </ItemsControl>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Quick-access language control -->
                    <ui:Button Appearance="Secondary"
                               Padding="10,4"
                               Command="{Binding ToggleLanguageCommand}"
                               Content="{Binding LanguageToggleLabel}"
                               Icon="{ui:SymbolIcon LocalLanguage24}"
                               ToolTip="{loc:Loc Settings.Language}" />

                    <ui:Button Margin="8,0,0,0"
                               Appearance="Secondary"
                               Padding="8,4"
                               Command="{Binding RefreshStatusCommand}"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               ToolTip="{loc:Loc Status.Refresh}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
