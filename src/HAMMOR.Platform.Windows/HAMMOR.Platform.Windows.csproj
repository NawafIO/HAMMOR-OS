<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-only implementations that are still not UI: DPAPI secret storage
    and NAudio device enumeration / playback. Separated from HAMMOR.App so the
    UI has no monopoly on platform services and Core stays portable.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HAMMOR.Platform.Windows</RootNamespace>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HAMMOR.Core\HAMMOR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
